# Copy to `.env` and replace placeholder values. Referenced by `docker-compose.yml`
# (firestore, cv-api, admin-api, llm-service). Do not commit `.env`.

# --- Firestore (ADR-0021) ---
# The one database for cv-api and admin-api, separated by top-level collection.
# There is no connection string and no database password: locally the SDKs talk
# to the emulator, in GCP they authenticate as the service account.
#
# Project id namespacing the data. Compose defaults it to `applysy-local`; the
# emulator accepts any id and creates it on first write.
GOOGLE_CLOUD_PROJECT=applysy-local
#
# FIRESTORE_EMULATOR_HOST is what redirects the SDKs to the emulator, but it is
# NOT read from this file: docker-compose sets it per service (`firestore:8085`)
# and `scripts/dev.sh` exports it for host-run servers (`localhost:8085`).
# Override it in your shell, not here.

# --- cv-api (compose maps to JwtSettings__Secret) ---
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Shared key admin-api uses to call cv-api's /api/admin/* endpoints (ADR-0005).
# Must match between cv-api and admin-api; compose defaults both to "localdevkey".
CV_API_ADMIN_KEY=localdevkey

# --- admin-api ---
# HS256 signing secret for admin sessions (compose maps it to JWT_SECRET on
# admin-api). Required whenever the admin stack is up.
ADMIN_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Optional: email seeded into the `admin_users` collection on first run, so the
# first operator can sign in. Leave empty to seed nothing.
# ADMIN_SEED_EMAIL=you@example.com

# --- Google Sign-In (OAuth 2.0 Web client ID) ---
# Use the same value in `apps/ui-react` / `apps/ui-angular` `src/environments/environment.ts`
# as `googleClientId`. Docker Compose maps this to cv-api as `Google__ClientId`.

# Web application OAuth 2.0 client — used by Angular/admin-ui Sign-In button and cv-api ID token validation.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Chrome Extension OAuth 2.0 client — used by the browser extension via chrome.identity.getAuthToken().
GOOGLE_EXTENSION_CLIENT_ID=your-extension-client-id.apps.googleusercontent.com
# Client secret for the Web application client (cv-api code-exchange flow).
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- llm-service: Gemini when LLM_PROVIDER=google (default in compose) ---
GOOGLE_API_KEY=AIzaSy...

# --- llm-service: provider ---
# google = Gemini | openai / lm_studio / lm-studio = OpenAI-compatible | foundry = Azure AI Foundry (Claude)
LLM_PROVIDER=google

# Model / deployment name: Gemini model when google; Anthropic deployment when foundry; overrides OPENAI_MODEL when openai.
# LLM_MODEL=gemini-1.5-flash

# Optional sampling temperature 0–2 (default 0.4).
# LLM_TEMPERATURE=0.4

# --- LLM_PROVIDER=openai (LM Studio, local OpenAI-compatible, etc.) ---
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# From a container to LM Studio on the host: http://host.docker.internal:1234/v1
# OPENAI_API_KEY=lm-studio
# OPENAI_MODEL=local-model

# --- LLM_PROVIDER=foundry (variable names match apps/llm-service/app/settings.py) ---
# Key from Azure portal (Keys and Endpoint). Required when LLM_PROVIDER=foundry.
# FOUNDRY_API_KEY=

# Full base URL to the Anthropic-compatible endpoint, no trailing slash (e.g. .../anthropic).
# If unset, the client uses FOUNDRY_DEPLOYMENT_NAME as the Azure resource name instead.
# FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/anthropic

# Resource / deployment: used as Azure `resource=` when FOUNDRY_BASE_URL is empty; also model name
# when LLM_MODEL is unset. Prefer setting LLM_MODEL for the deployment name when both are needed.
# FOUNDRY_DEPLOYMENT_NAME=your-resource

# LLM_MODEL=claude-haiku-4-5

# Optional max tokens for Foundry (default 8192).
# ANTHROPIC_FOUNDRY_MAX_TOKENS=8192

# --- Distributed tracing: OpenTelemetry → Grafana Tempo (optional, ADR-0016) ---
# Opt-in: cv-api and llm-service export request traces only when this endpoint is
# set; otherwise tracing is a no-op. The docker-compose stack defaults it to the
# in-network Tempo (http://tempo:4317); view traces in Grafana (http://localhost:3003).
# For host-run dev servers, `npm run dev -- --with-obs` sets it to http://localhost:4317.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# --- LLM observability: Langfuse (optional, ADR-0010) ---
# Opt-in: tracing in llm-service activates only when all three are set; otherwise
# it is a no-op with no behaviour change. Self-hosted Langfuse (data stays in-house).
# Run a local Langfuse with the opt-in overlay (auto-provisions matching dev keys):
#   docker compose -f docker-compose.yml -f docker-compose.langfuse.yml up   # UI at http://localhost:3030
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3030
#
# Local Langfuse UI login, auto-provisioned on FIRST boot of the overlay only
# (ignored once the user exists — change it in the UI afterwards). Must be a
# valid email. Defaults: admin@example.com / changeme-langfuse.
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_PASSWORD=changeme-langfuse
#
# The Langfuse overlay carries its own Postgres — Langfuse hard-requires
# Postgres and cannot run on Firestore, so it is the only Postgres left in the
# repo (ADR-0021). These override that container's credentials and default to
# langfuse/langfuse; nothing else reads them.
# POSTGRES_USER=langfuse
# POSTGRES_PASSWORD=langfuse

# --- LLM Evals (Langfuse datasets + experiments, ADR-0012) ---
# Evals run through Langfuse: fixtures in apps/llm-service/evals/fixtures/*.jsonl
# are upserted into datasets named eval-<operation> and each run is a dataset
# experiment, viewable in the Langfuse UI. Results are also written to
# apps/llm-service/evals/results/<operation>_latest.json and the suite exits
# non-zero when a metric falls below its threshold (quality gate for CI).
# Requires the LANGFUSE_* credentials above; the runner errors if they are unset.
# Local: start the Langfuse overlay, then `npm run evals` (wraps nx run
# llm-service:evals, injecting the local-dev keys; default runs all operations,
# forward args with `npm run evals -- --operation extract`). To run against a
# non-local Langfuse, set LANGFUSE_* explicitly and call the module directly:
#   cd apps/llm-service && python -m evals.run_evals --operation all
