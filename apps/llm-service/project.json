{
  "name": "llm-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/llm-service",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production"],
      "outputs": [],
      "options": {
        "command": "docker build -t llm-service .",
        "cwd": "apps/llm-service"
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/pyproject.toml"],
      "outputs": ["{projectRoot}/.venv"],
      "options": {
        "command": "python3.13 -m venv .venv && .venv/bin/pip install -q -e .",
        "cwd": "apps/llm-service"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["install"],
      "options": {
        "command": ".venv/bin/python -m app.main",
        "cwd": "apps/llm-service"
      }
    },
    "serve-host": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["install"],
      "options": {
        "command": ".venv/bin/python -m app.main",
        "cwd": "apps/llm-service",
        "env": {
          "GRPC_PORT": "50051"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "options": {
        "command": "python3 -m py_compile app/main.py app/schemas.py app/chains/cv_chain.py && echo 'Syntax OK'",
        "cwd": "apps/llm-service"
      }
    },
    "evals": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": ".venv/bin/python -m evals.run_evals",
        "cwd": "apps/llm-service",
        "env": {
          "LANGFUSE_PUBLIC_KEY": "pk-lf-local-dev",
          "LANGFUSE_SECRET_KEY": "sk-lf-local-dev",
          "LANGFUSE_HOST": "http://localhost:3030"
        }
      }
    }
  }
}
