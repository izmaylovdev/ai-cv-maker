{
  "id": null,
  "uid": "cv-maker-tracing",
  "title": "CV Maker — Request Tracing",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Requests (1h)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
          "expr": "sum(increase(http_requests_received_total{job=\"cv-api\"}[1h]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [] }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Rate 4xx+5xx (1h)",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
          "expr": "sum(increase(http_requests_received_total{job=\"cv-api\",code=~\"4..|5..\"}[1h])) / sum(increase(http_requests_received_total{job=\"cv-api\"}[1h])) * 100",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95 Latency (5m)",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"cv-api\"}[$__rate_interval]))) * 1000",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP Request Rate by Endpoint",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
          "expr": "sum by (endpoint) (rate(http_requests_received_total{job=\"cv-api\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Avg Latency by Endpoint (ms)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
          "expr": "sum by (endpoint) (rate(http_request_duration_seconds_sum{job=\"cv-api\"}[$__rate_interval])) / sum by (endpoint) (rate(http_request_duration_seconds_count{job=\"cv-api\"}[$__rate_interval])) * 1000",
          "legendFormat": "{{endpoint}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"cv-api\"}[$__rate_interval]))) * 1000",
          "legendFormat": "P95 overall"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "gRPC Call Duration by Method (ms)",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
          "expr": "sum by (method) (rate(grpc_server_handled_seconds_sum{job=\"llm-service\"}[$__rate_interval])) / sum by (method) (rate(grpc_server_handled_seconds_count{job=\"llm-service\"}[$__rate_interval])) * 1000",
          "legendFormat": "{{method}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1
          }
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP P95 Latency by Endpoint (ms)",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prom-cv-maker" },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket{job=\"cv-api\"}[$__rate_interval]))) * 1000",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1
          }
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Recent Traces",
      "description": "End-to-end traces from Tempo (ADR-0016). The Request column shows the root span's url.path (span Name only carries the HTTP verb when no route template matched). Click a Trace ID to open the full cross-service waterfall (cv-api HTTP → gRPC → llm-service → LLM call).",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 10 },
      "datasource": { "type": "tempo", "uid": "tempo-cv-maker" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo-cv-maker" },
          "queryType": "traceql",
          "query": "{} | select(span.url.path)",
          "tableType": "traces",
          "limit": 20
        }
      ],
      "options": {},
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Recent Errored Traces",
      "description": "Traces containing a span with status=error (5xx / gRPC faults). Click a Trace ID to open the waterfall and find the failing span.",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 10 },
      "datasource": { "type": "tempo", "uid": "tempo-cv-maker" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo-cv-maker" },
          "queryType": "traceql",
          "query": "{ status = error }",
          "tableType": "traces",
          "limit": 20
        }
      ],
      "options": {},
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Slow cv-api Traces (>500ms)",
      "description": "cv-api-rooted traces slower than 500ms. Click a Trace ID to open the waterfall and see where the time goes.",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 10 },
      "datasource": { "type": "tempo", "uid": "tempo-cv-maker" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo-cv-maker" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"cv-api\" && duration > 500ms }",
          "tableType": "traces",
          "limit": 20
        }
      ],
      "options": {},
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
